{
  "name": "lmrt",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Chrome extension (let me read this): reads text files aloud. Starts with Markdown.",
  "scripts": {
    "test": "node --test --experimental-test-coverage --test-coverage-include=\"src/**/*.js\" --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 \"test/**/*.test.js\"",
    "build": "node scripts/build.mjs",
    "pin": "node scripts/pin-voices.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm test"
  },
  "devDependencies": {
    "@diffusionstudio/piper-wasm": "^1.0.0",
    "@eslint/js": "^9.39.5",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "kokoro-js": "^1.2.1",
    "onnxruntime-web": "^1.31.1",
    "prettier": "^3.9.10"
  }
}
