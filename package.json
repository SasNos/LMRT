{
  "name": "lmrt",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Chrome extension (let me read this): reads text files aloud. Starts with Markdown.",
  "scripts": {
    "test": "node --test --experimental-test-coverage --test-coverage-include=\"src/**/*.js\" --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 \"test/**/*.test.js\"",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm test",
    "install-host": "node scripts/install-host.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "prettier": "^3.9.10"
  }
}
